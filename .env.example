# BMKG Sinoptik API (token auto-refresh setiap ~47 jam)
BMKG_USERNAME=psimkg
BMKG_PASSWORD=your_password_here
BMKG_API_BASE=https://bmkgsatu.bmkg.go.id

# SFTP litbangweb
SFTP_HOST=202.90.199.54
SFTP_PORT=3346
SFTP_USER=litbangweb
SFTP_PASSWORD=your_sftp_password
SFTP_NC_REMOTE=/opt/lampp/htdocs/wrf/wrfout
SFTP_OBS_PATH=/opt/lampp/htdocs/wrf/monas_obs

# Download observasi BMKG → folder lokal → SFTP ke litbangweb
OBS_EXPORT_DIR=D:\nwp-data\obs
# Rentang default --from-june (kosong = 1 Juni tahun berjalan)
OBS_FETCH_START=2026-06-01T00:00:00Z

# Model NC paths — LOCAL MODE (Opsi B: komputer BMKG)
INANWP_NC_PATH=C:\nwp-data\models\InaNWP
INACAWO_NC_PATH=C:\nwp-data\models\InaCAWO
GFS_NC_PATH=C:\nwp-data\models\GFS
IFS_NC_PATH=C:\nwp-data\models\IFS

# Atau satu file spesifik (contoh PC BMKG):
LOCAL_NC_PATH=C:\Users\husei\Downloads\2026070112-d01-asim.nc

# Pipeline & observasi
FORCE_PIPELINE=false
AUTO_SYNC_OBS=false
USE_LOCAL_OBS_JSON=true
DISABLE_SFTP=true
ENABLE_PIPELINE_SCHEDULER=false
SEED_DEMO_DATA=false
USE_DUMMY_MODELS=true

# Parallel verify di PC/HPC (4 model sekaligus)
PARALLEL_VERIFY=true
PARALLEL_WORKERS=4
# Windows PC: thread | Linux HPC: process
PARALLEL_BACKEND=thread

# webpsi serve-only (set true di /var/www/monas/.env)
SERVE_READONLY=false

# Sync artifact harian PC → webpsi (isi jika SSH tersedia)
WEBPSI_HOST=
WEBPSI_USER=
WEBPSI_PATH=/var/www/monas/data/artifacts
WEBPSI_SSH_PORT=22
ARTIFACTS_DIR=

# Large NC: chunked read threshold (bytes, default 500MB)
NC_CHUNK_THRESHOLD_BYTES=500000000

# Peta Leaflet (Carto basemaps) — wajib ?key= pada URL tile (bukan api_key)
CARTO_API_KEY=

# --- Dev lokal (PC BMKG) — BASE_PATH kosong, akses http://localhost:3013 ---
API_HOST=127.0.0.1
API_PORT=8013
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=3013
BASE_PATH=
CORS_ORIGIN=http://localhost:3013

# --- litbangweb (compute, tanpa internet) ---
# OFFLINE_OBS_MODE=true
# LITBANGWEB_OBS_DIR=/opt/lampp/htdocs/wrf/monas_obs
# BASE_PATH=/monas
# CORS_ORIGIN=https://psimkg.bmkg.go.id
# SEED_DEMO_DATA=false
# NC_DATA_PATH=/var/www/monas/data/nc
# INANWP_NC_PATH=/var/www/monas/data/nc
# DEPLOY_PATH=/var/www/monas
