# Contoh env untuk container litbangweb (mount di run, atau --env-file)
# Jangan commit secret; salin ke /opt/lampp/htdocs/monas/compute.env di server

OFFLINE_OBS_MODE=true
USE_LOCAL_OBS_JSON=true
LITBANGWEB_OBS_DIR=/data/obs
OBS_EXPORT_DIR=/data/obs

INANWP_NC_PATH=/data/nc
INACAWO_NC_PATH=/data/nc
GFS_NC_PATH=/data/nc
IFS_NC_PATH=/data/nc

USE_DUMMY_MODELS=false
SEED_DEMO_DATA=false
DISABLE_SFTP=true
ENABLE_PIPELINE_SCHEDULER=false
SERVE_READONLY=false
FORCE_PIPELINE=false

PARALLEL_VERIFY=true
PARALLEL_BACKEND=process
PARALLEL_WORKERS=4

OBS_FETCH_START=2026-06-01T00:00:00Z
ARTIFACTS_DIR=/app/data/artifacts
